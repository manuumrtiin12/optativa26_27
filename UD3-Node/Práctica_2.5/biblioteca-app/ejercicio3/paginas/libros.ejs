<%- include('partials/cabecera') %>
  <h1><%= titulo %></h1>
  <p>Total: <%= libros.length %> libros</p>
  <% if (libros.length > 0) { %>
    <table>
      <tr>
        <th>Título</th>
        <th>Autor</th>
        <th>Año</th>
        <th>Estado</th>
      </tr>
      <% libros.forEach(libro => { %>
        <tr>
          <td>
            <%= libro.titulo %>
            <% if (libro.anio < 2000) { %>
              (clásico)
            <% } %>
          </td>
          <td><%= libro.autor %></td>
          <td><%= libro.anio %></td>
          <td>
            <% if (libro.disponible) { %>
              <span class="disponible">Disponible</span>
            <% } else { %>
              <span class="prestado">Prestado</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </table>
  <% } else { %>
    <p>No hay libros que mostrar</p>
  <% } %>
<%- include('partials/pie') %>
